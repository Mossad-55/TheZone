{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch TheZone.Api (https)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/TheZone.Api/bin/Debug/net10.0/TheZone.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/TheZone.Api",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bnow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "launchSettingsProfile": "https"
    }
  ]
}